# Настройки одного бота. Новый клиент = копия этого файла + база знаний, без правки кода.
# Многострочный текст пишется одной строкой, перенос строки — \n.

# ── Обязательно ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=your_bot_token_here

# Куда приходят заявки и вопросы без ответа: id владельца (узнать у @userinfobot)
# или id рабочей группы (отрицательный, бота нужно добавить в группу).
OWNER_CHAT_ID=123456789

# Как бот называет бизнес клиентам.
BUSINESS_NAME=Фотостудия «Светотень»

# Телефон, адрес и часы работы: бот даёт их по кнопке «Контакты», при отказе
# оставить номер, при сбое нейросети и при недоставленной заявке.
BUSINESS_CONTACTS=📞 +7 900 000-00-00\n📍 Москва, ул. Примерная, д. 12, 3 этаж, вход со двора\n🕙 Ежедневно 9:00–22:00

# ── Нейросеть ───────────────────────────────────────────────────────────────
# gigachat (по умолчанию) | yandexgpt | openai
LLM_PROVIDER=gigachat

# --- GigaChat (LLM_PROVIDER=gigachat) ---
# Authorization Key из личного кабинета developers.sber.ru — base64(ClientID:ClientSecret).
GIGACHAT_AUTH_KEY=your_base64_authorization_key_here
# Физлицо — GIGACHAT_API_PERS, ИП и юрлица — GIGACHAT_API_B2B или GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 (Lite) | GigaChat-2-Pro | GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат Минцифры (скачивается `make cert`).
GIGACHAT_CERT_PATH=certs/russian_trusted_root_ca.cer
# Крайний фолбэк для локального демо: true отключает проверку TLS. НИКОГДА в проде.
GIGACHAT_INSECURE_SKIP_VERIFY=false

# --- YandexGPT (LLM_PROVIDER=yandexgpt) ---
# YANDEX_API_KEY=your_yandex_api_key_here
# YANDEX_FOLDER_ID=your_folder_id_here
# YANDEX_MODEL=yandexgpt-lite

# --- Сервис с API как у OpenAI (LLM_PROVIDER=openai): ChatGPT, DeepSeek и т.п. ---
# Внимание: вопросы клиентов уходят на серверы за рубежом, оплату сервиса
# клиент оформляет сам.
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=deepseek-chat

# Тарифы для сводки экзамена, ₽ за 1 000 токенов, и минимальный платёж в месяц.
# Боту не нужны. Пример: GigaChat Lite для юрлиц и ИП.
# LLM_PRICE_INPUT_PER_1K=0.065
# LLM_PRICE_OUTPUT_PER_1K=0.065
# LLM_MIN_MONTHLY=600

# ── Тексты (необязательно, у всех есть умолчания) ────────────────────────────
# GREETING_TEXT=Здравствуйте! Я онлайн-помощник фотостудии «Светотень». Спросите о съёмках, ценах и аренде зала.
# BUTTON_LEAD_TEXT=📝 Оставить заявку
# BUTTON_CONTACTS_TEXT=📍 Контакты
# LEAD_SENT_TEXT=Спасибо! Заявка передана, с вами скоро свяжутся.
# QUESTION_SENT_TEXT=Спасибо! Вопрос передан администратору, с вами скоро свяжутся.
# DELIVERY_FAILED_TEXT=Извините, передать сообщение не получилось: связь сейчас нестабильна. Пожалуйста, свяжитесь с нами напрямую:
# OWNER_REPLY_PREFIX=Вам ответил администратор:

# Согласие на обработку данных: показывается перед запросом телефона. Пусто — строки нет.
# CONSENT_TEXT=Отправляя номер, вы соглашаетесь на обработку персональных данных.
# PRIVACY_URL=https://example.ru/privacy

# ── Поведение (необязательно) ───────────────────────────────────────────────
# Бот сам предлагает заявку, когда видит намерение купить или записаться.
# LEAD_OFFER_ENABLED=true
# Лимиты на одного человека в час; 0 — без ограничения.
# LIMIT_LEADS_PER_HOUR=3
# LIMIT_QUESTIONS_PER_HOUR=20
# Часовой пояс времени в заявках.
# TIMEZONE=Europe/Moscow

# ── Администратор и статистика (необязательно) ──────────────────────────────
# Telegram id того, кому доступны /reload и /stats. Пусто — никому.
ADMIN_TG_ID=123456789

# Обезличенная статистика для /stats. Пусто — бот ничего не пишет.
# В docker-compose.stats.yml подставляется автоматически.
# DATABASE_URL=postgres://consultant:consultant@localhost:5432/consultant?sslmode=disable

# Креды Postgres для docker-compose.stats.yml
# POSTGRES_USER=consultant
# POSTGRES_PASSWORD=consultant
# POSTGRES_DB=consultant
# POSTGRES_PORT=5432

# ── Прочее ──────────────────────────────────────────────────────────────────
# Путь к базе знаний (в Docker — внутри смонтированного каталога knowledge/).
KNOWLEDGE_PATH=knowledge/faq.md

# local -> текстовый лог уровня Debug, любое другое значение -> JSON уровня Info
APP_ENV=local
